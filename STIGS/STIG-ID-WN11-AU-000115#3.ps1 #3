# Shows the current audit setting for Sensitive Privilege Use
function Get-AuditSetting {
    $Line = auditpol /get /subcategory:"Sensitive Privilege Use" | Select-String "Sensitive Privilege Use"
    return ($Line.ToString() -replace "Sensitive Privilege Use", "").Trim()
}

# WN11-AU-000115
# Turn on Success auditing for Sensitive Privilege Use

auditpol /set /subcategory:"Sensitive Privilege Use" /success:enable | Out-Null

# Verify configuration
$Current = Get-AuditSetting
Write-Host "Sensitive Privilege Use auditing is now: $Current"

if ($Current -match "Success") {
    Write-Host "SUCCESS: WN11-AU-000115 configured." -ForegroundColor Green
} else {
    Write-Host "FAILED: Success auditing is not on." -ForegroundColor Red
}
