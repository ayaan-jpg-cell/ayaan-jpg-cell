# Shows the current audit setting for Detailed File Share
function Get-AuditSetting {
    $Line = auditpol /get /subcategory:"Detailed File Share" | Select-String "Detailed File Share"
    return ($Line.ToString() -replace "Detailed File Share", "").Trim()
}

# WN11-AU-000570
# Turn on Failure auditing for Detailed File Share

auditpol /set /subcategory:"Detailed File Share" /failure:enable | Out-Null

# Verify configuration
$Current = Get-AuditSetting
Write-Host "Detailed File Share auditing is now: $Current"

if ($Current -match "Failure") {
    Write-Host "SUCCESS: WN11-AU-000570 configured." -ForegroundColor Green
} else {
    Write-Host "FAILED: Failure auditing is not on." -ForegroundColor Red
}
